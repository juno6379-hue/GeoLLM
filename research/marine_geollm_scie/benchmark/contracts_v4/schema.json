{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Marine GeoLLM task obligation review contract v4",
  "type": "object",
  "required": ["contract_version", "case_id", "query", "annotation_status", "human_approval", "source_human_approval", "evaluation_enabled", "post_hoc", "holdout_eligible", "source_provenance", "transcribed_approved_values", "task_obligations", "acceptable_capability_combinations", "execution_guards", "unresolved"],
  "properties": {
    "contract_version": {"const": "v4_DRAFT"},
    "case_id": {"type": "string", "pattern": "^PILOT_Q[1-6]_0[1-3]$"},
    "query": {"type": "string", "minLength": 1},
    "annotation_status": {"const": "DRAFT"},
    "human_approval": {"const": false},
    "source_human_approval": {"const": true},
    "evaluation_enabled": {"const": false},
    "post_hoc": {"const": true},
    "holdout_eligible": {"const": false},
    "source_provenance": {
      "type": "object",
      "required": ["query", "semantics", "qec_fields", "qec_original_text", "behavior", "evidence", "uncertainty", "spatial"],
      "additionalProperties": {"$ref": "#/$defs/source"}
    },
    "transcribed_approved_values": {
      "type": "object", "required": ["qec_fields", "spatial", "expected_behavior", "transcription_policy"],
      "properties": {
        "qec_fields": {"type": "object"}, "spatial": {"type": ["object", "null"]},
        "expected_behavior": {"type": ["string", "null"]},
        "transcription_policy": {"const": "EXACT_COPY_NO_NEW_INTERPRETATION"}
      }
    },
    "task_obligations": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["obligation_id", "status", "supporting_sources", "automatic_pass_rule"],
      "properties": {"obligation_id": {"type": "string"}, "status": {"const": "PROPOSED_INTERPRETATION"},
        "supporting_sources": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "automatic_pass_rule": {"type": "null"}}
    }},
    "acceptable_capability_combinations": {"type": "array", "items": {
      "type": "object", "required": ["status", "all_of", "sufficient_for_execution"],
      "properties": {"status": {"const": "PROPOSED_NOT_APPROVED"}, "sufficient_for_execution": {"const": false},
        "all_of": {"type": "array", "minItems": 1, "items": {
          "type": "object", "required": ["capability_id", "runtime_availability", "provenance"],
          "properties": {"capability_id": {"type": "string"}, "runtime_availability": {"const": "NOT_VERIFIED"}, "provenance": {"$ref": "#/$defs/source"}}
        }}}
    }},
    "execution_guards": {"type": "object", "required": ["new_default_geometry", "new_default_radius_m"],
      "properties": {"new_default_geometry": {"type": "null"}, "new_default_radius_m": {"type": "null"}}},
    "unresolved": {"type": "object", "required": ["interpretation_approval_required", "complete_semantic_pass_criteria", "complete_evidence_pass_criteria"],
      "properties": {"interpretation_approval_required": {"const": true}, "complete_semantic_pass_criteria": {"type": "null"}, "complete_evidence_pass_criteria": {"type": "null"}}}
  },
  "$defs": {"source": {
    "type": "object", "required": ["source_path", "source_sha256", "json_pointer", "exact_text", "text_sha256", "span_start", "span_end", "span_unit"],
    "properties": {"source_path": {"type": "string"}, "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
      "json_pointer": {"type": "string", "pattern": "^/"}, "exact_text": {"type": "string"},
      "text_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
      "span_start": {"const": 0}, "span_end": {"type": "integer", "minimum": 0}, "span_unit": {"const": "unicode_code_points"}}
  }}
}
