[
  {
    "agent_name": "Spatial Analysis Agent",
    "entry_point": "services.spatial_analysis_agent.agent.execute_spatial_analysis",
    "clearance_level": 1,
    "description": "공간 연산(버퍼, 교차, 포함 등)을 통해 해양 객체들의 공간적 관계를 분석하는 에이전트.",
    "capabilities": [
      {
        "intent": "spatial_proximity_search",
        "description": "특정 위치 또는 객체 주변의 해양공간 객체를 거리 조건으로 검색한다.",
        "required_slots": ["location", "distance_m", "target_object"],
        "optional_slots": ["time_range", "filters"],
        "tools": ["postgis.dwithin", "gbenc.s101_feature_search"],
        "outputs": ["geojson", "map_layer", "summary"]
      },
      {
        "intent": "spatial_overlay_intersection",
        "description": "두 개 이상의 해양공간 레이어 간 중첩, 교차 관계를 분석한다.",
        "required_slots": ["target_object_1", "target_object_2"],
        "tools": ["postgis.intersection", "postgis.overlay"],
        "outputs": ["metrics", "map_layer", "table"]
      },
      {
        "intent": "spatial_containment",
        "description": "특정 구역 내부에 존재하는 객체를 필터링하여 찾는다.",
        "required_slots": ["base_area", "target_object"],
        "tools": ["postgis.within"],
        "outputs": ["geojson", "map_layer", "summary"]
      }
    ]
  },
  {
    "agent_name": "Standard RAG Agent",
    "entry_point": "services.standard_rag_agent.agent.execute_rag_search",
    "clearance_level": 1,
    "description": "해양 규정, 법규, 표준 지식에 대한 RAG 기반 검색을 수행하는 에이전트.",
    "capabilities": [
      {
        "intent": "definition_search",
        "description": "특정 해양 용어나 규정의 의미를 검색한다.",
        "required_slots": ["target_term"],
        "tools": ["rag.document_search"],
        "outputs": ["text_summary"]
      },
      {
        "intent": "s101_feature_mapping",
        "description": "자연어 단어를 S-101 전자해도 객체명 또는 NFTC 코드로 매핑한다.",
        "required_slots": ["target_term"],
        "tools": ["rag.s101_dictionary_search"],
        "outputs": ["text_summary", "nftc_code"]
      },
      {
        "intent": "s101_rendering_rule",
        "description": "S-101 Portrayal Catalogue에 따른 특정 객체의 화면 렌더링 규칙을 검색한다.",
        "required_slots": ["target_feature"],
        "tools": ["rag.portrayal_catalogue_search"],
        "outputs": ["text_summary", "svg_icon"]
      }
    ]
  },
  {
    "agent_name": "Map Agent",
    "entry_point": "services.map_agent.agent.execute_map_agent",
    "clearance_level": 1,
    "description": "추출된 공간 데이터나 객체를 웹 지도 위에 시각화하는 보조 에이전트.",
    "capabilities": [
      {
        "intent": "map_visualization",
        "description": "GeoJSON 또는 공간 좌표 데이터를 시각화 레이어로 렌더링한다.",
        "required_slots": ["map_data"],
        "tools": ["map.render_layer", "map.draw_buffer"],
        "outputs": ["map_layer"]
      }
    ]
  },
  {
    "agent_name": "AIS Analysis Agent",
    "entry_point": "services.ais_analysis_agent.agent.execute_ais_analysis",
    "clearance_level": 2,
    "description": "선박의 실시간/과거 AIS 항적 데이터와 통항량을 분석하는 에이전트.",
    "capabilities": [
      {
        "intent": "ais_track_search",
        "description": "특정 선박(MMSI)의 항적을 조회한다.",
        "required_slots": ["mmsi", "time_range"],
        "tools": ["ais.get_track"],
        "outputs": ["geojson", "table"]
      }
    ]
  },
  {
    "agent_name": "Data Discovery Agent",
    "entry_point": "services.data_discovery_agent.agent.execute_data_discovery",
    "clearance_level": 1,
    "description": "내부 카탈로그, 외부 기상청/해수부 API 및 로컬 파일(CSV 등)로부터 데이터를 검색하고 가져오는 에이전트.",
    "capabilities": [
      {
        "intent": "DATA_DISCOVERY",
        "description": "통계, 사고 데이터, 레저 데이터 등 특정 주제에 대한 데이터 소스를 검색 및 Fetch 한다.",
        "required_slots": ["target_term"],
        "tools": ["data.fetch_csv", "data.external_api"],
        "outputs": ["table", "text_summary", "json"]
      }
    ]
  },
  {
    "agent_name": "Drone LiDAR Analysis Agent",
    "entry_point": "services.drone_analysis_agent.agent.DroneLiDARAnalysisAgent.process",
    "clearance_level": 2,
    "description": "드론 기반 LiDAR Point Cloud와 정사영상/항공영상 데이터를 분석하여 3D 지형, 시설물 변화, 위험요소 등을 탐지하는 에이전트.",
    "capabilities": [
      {
        "intent": "drone_lidar_change_detection",
        "description": "드론 LiDAR 데이터와 정사영상을 중첩해서 변화 및 객체를 탐지한다.",
        "required_slots": ["area_of_interest", "input_assets", "analysis_type"],
        "tools": [
          "pdal.info", "pdal.pipeline", "entwine.build", "cesium.3dtiles.converter",
          "rasterio.analysis", "ai.object_detection"
        ],
        "outputs": ["map_layer", "point_cloud_tiles", "change_map", "summary", "report_section", "validation_metrics"]
      }
    ]
  },
  {
    "agent_name": "Accident/Risk Agent",
    "entry_point": "services.accident_risk_agent.agent.execute_accident_risk",
    "clearance_level": 1,
    "description": "사고 공간 레이어와 사고-위험객체 관계를 근거 기반으로 제공하는 Agent.",
    "capabilities": [
      {
        "intent": "accident_feature_relation",
        "description": "사고 이벤트, 사고 유형, 사고 공간 레이어를 위험객체와 연결한다.",
        "required_slots": ["feature_instance_id"],
        "tools": ["accident.s101_relation_lookup"],
        "outputs": ["geojson", "map_layer", "accident_relation_evidence", "summary"]
      },
      {
        "intent": "accident_relation_lookup",
        "description": "검증된 전자해도 객체 식별자로 사고-S101 relation 테이블을 조회한다.",
        "required_slots": ["feature_instance_id"],
        "tools": ["accident.s101_relation_lookup"],
        "outputs": ["geojson", "accident_relation_evidence", "summary"]
      }
    ]
  },
  {
    "agent_name": "Time-Series Agent",
    "entry_point": "services.time_series_agent.agent.execute_time_series_analysis",
    "clearance_level": 1,
    "description": "Read-only agent for observation time-series metrics, missing-value checks, and anomaly detection.",
    "capabilities": [
      {
        "intent": "observed_time_series_analysis",
        "description": "Analyze station or file-backed observation time-series data and return deterministic metrics.",
        "required_slots": ["source_path", "timestamp_column", "value_column"],
        "optional_slots": ["dataset_id", "station_id", "time_range", "z_threshold"],
        "tools": ["timeseries.observation_analyze"],
        "outputs": ["metrics", "anomaly_table", "summary"]
      }
    ]
  },
  {
    "agent_name": "Time-Series Forecast Agent",
    "entry_point": "services.time_series_agent.forecast_agent.execute_time_series_forecast",
    "clearance_level": 1,
    "description": "Read-only forecasting agent for observation time-series values with confidence intervals.",
    "capabilities": [
      {
        "intent": "observed_time_series_forecast",
        "description": "Generate short or medium horizon forecasts and confidence intervals from registered observation time-series data.",
        "required_slots": ["source_path", "timestamp_column", "value_column", "horizon_steps"],
        "optional_slots": ["dataset_id", "station_id", "time_range", "confidence_level", "model_endpoint"],
        "tools": ["timeseries.forecast"],
        "outputs": ["forecast", "confidence_interval", "summary"]
      }
    ]
  },
  {
    "agent_name": "Validation Agent",
    "entry_point": "services.validation_agent.agent.execute_validation",
    "clearance_level": 1,
    "description": "KG path, provenance, DB and geometry execution state를 검증하는 Agent.",
    "capabilities": [
      {
        "intent": "validation",
        "description": "LLM 추측 없이 graph path와 source provenance 및 실행 가능 상태를 검증한다.",
        "required_slots": [],
        "tools": [],
        "outputs": ["validation_payload", "status", "blocked_reason"]
      }
    ]
  }
]
