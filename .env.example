# Local Ollama only. OPENAI_* names are retained solely because the
# OpenAI-compatible LangChain client reads these names; traffic stays local.
OLLAMA_BASE_URL="http://host.docker.internal:11434"
OLLAMA_CHAT_URL="http://host.docker.internal:11434/v1"
OLLAMA_EMBEDDING_URL="http://host.docker.internal:11434/api/embed"
OPENAI_BASE_URL="http://host.docker.internal:11434/v1"
OPENAI_API_KEY="ollama"
LLM_MODEL="gemma2"
EMBEDDING_MODEL="bge-m3"

# 1. Local PostGIS Connection String
# Host access to the an_geollm_postgis container.
POSTGIS_URL="postgresql://postgres:postgres@localhost:5433/marine_geo"

# S-101 2.0 canonical target. This must point at the restored gbhd_s101 DB.
# Host execution:
S101_DB_URL="postgresql://postgres:postgres@localhost:5433/gbhd_s101"
# Docker execution equivalent:
# S101_DB_URL="postgresql://postgres:postgres@db:5432/gbhd_s101"
S101_PRODUCT_SPECIFICATION="INT.IHO.S-101.2.0"
S101_CATALOGUE_VERSION="2.0.0"
S101_RAG_METADATA_FILTER='{"product_id":"S-101","version":"2.0.0","product_specification":"INT.IHO.S-101.2.0"}'

# 2. Oracle (MDC DB) Connection String (configure locally if required)
ORACLE_URL=""

# 3. GBENC (S-100/S-101 ENC DB) Environment Variables
GBENC_DB_HOST=""
GBENC_DB_PORT="39101"
GBENC_DB_NAME="gbenc"
GBENC_DB_USER="postgres"
GBENC_DB_PASSWORD=""

# OpenTelemetry Tracing Service Name
OTEL_SERVICE_NAME="marine-geollm"

# Audit Log Level (INFO, DEBUG)
LOG_LEVEL="INFO"

# UTF-8 runtime settings for Korean logs and API messages.
LANG="C.UTF-8"
LC_ALL="C.UTF-8"
PYTHONUTF8="1"
PYTHONIOENCODING="utf-8"

# Persistent orchestrator task metadata store.
# Defaults to ./geollm_state.sqlite3 when not set.
APP_STATE_DB_PATH="./geollm_state.sqlite3"

# Local file browsing/serving APIs are disabled by default.
# Enable only in trusted local development environments.
ENABLE_LOCAL_FILE_API="false"
APP_ALLOWED_FILE_ROOTS="D:\\An_GeoLLM"

# Required only when using public OSM/Nominatim/Overpass live candidate fetch.
# Use an application-identifying value and cache results. Do not use this for
# autocomplete, bulk geocoding, or systematic scraping.
GEOLLM_OSM_USER_AGENT="GeoLLM/0.1 local-development"
