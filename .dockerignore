# Ignore large archives
*.zip
*.tar
*.gz
*.tar.gz
*.bz2

# Ignore node_modules
node_modules/

# Ignore Python specific
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
env.bak/
venv.bak/

# Ignore IDE / Editor specific
.vscode/
.idea/
*.swp
*.swo

# Ignore logs and results
logs/
geollm_results/
# Compose mounts runtime evidence/KG and evaluation artifacts from the host.
# Do not copy local experiments, database exports or generated data into the image.
outputs/
processed/
tmp/
.pytest_cache/
.env
.env.*
!.env.example
geollm_state.sqlite3*
.gemini/
.git/
.codex/
.agents/

# Ignore large datasets if not needed in image
tiles/
S-111/
Dataset/
S-111.zip
