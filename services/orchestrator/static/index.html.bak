<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GeoLLM Map Agent Viewer</title>
    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>
        body { font-family: 'Inter', sans-serif; margin: 0; padding: 0; background: #0f172a; color: #f8fafc; }
        .container { display: flex; flex-direction: column; height: 100vh; }
        .header { background: #1e293b; padding: 15px 20px; border-bottom: 1px solid #334155; display: flex; justify-content: space-between; align-items: center; }
        .header h2 { margin: 0; font-size: 1.2rem; font-weight: 600; color: #38bdf8; }
        .header-badges span { background: #0369a1; padding: 4px 10px; border-radius: 4px; font-size: 12px; margin-left: 5px; }
        .main-content { display: flex; flex-grow: 1; overflow: hidden; }
        
        .sidebar { width: 350px; background: #1e293b; border-right: 1px solid #334155; display: flex; flex-direction: column; }
        .chat-box { padding: 15px; border-bottom: 1px solid #334155; display: flex; flex-direction: column; gap: 10px; }
        textarea { width: 100%; height: 80px; padding: 10px; border: 1px solid #475569; border-radius: 6px; background: #0f172a; color: #f8fafc; resize: none; font-size: 14px; box-sizing: border-box; }
        button { background: #0ea5e9; color: white; border: none; padding: 10px; border-radius: 6px; cursor: pointer; font-weight: bold; transition: background 0.2s; }
        button:hover { background: #0284c7; }
        button:disabled { background: #475569; cursor: not-allowed; }
        
        .log-area { flex-grow: 1; padding: 15px; overflow-y: auto; font-size: 13px; }
        .log-entry { margin-bottom: 15px; background: #0f172a; padding: 10px; border-radius: 6px; border-left: 3px solid #0ea5e9; }
        
        .status-badge { display: inline-block; padding: 3px 8px; border-radius: 4px; font-size: 11px; font-weight: bold; margin-bottom: 5px; }
        .status-received { background: #1e3a8a; color: #bfdbfe; }
        .status-executing { background: #854d0e; color: #fef08a; }
        .status-review { background: #7f1d1d; color: #fecaca; }
        .status-completed { background: #14532d; color: #bbf7d0; }
        
        .approve-btn { background: #dc2626; margin-top: 10px; display: none; width: 100%; }
        .approve-btn:hover { background: #b91c1c; }
        
        .map-container { flex-grow: 1; position: relative; }
        #map { width: 100%; height: 100%; background: #0f172a; }
        
        /* Custom Map Agent UI Overlay */
        .map-overlay { position: absolute; top: 15px; right: 15px; z-index: 1000; background: rgba(30, 41, 59, 0.9); padding: 10px; border-radius: 8px; border: 1px solid #334155; }
        .legend-title { font-size: 12px; font-weight: bold; color: #94a3b8; margin-bottom: 5px; text-transform: uppercase; }
        pre { background: #020617; padding: 8px; border-radius: 4px; overflow-x: auto; color: #38bdf8; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h2>🌍 GeoLLM Map Agent UI</h2>
            <div class="header-badges">
                <span>Orchestrator: Active</span>
                <span>Spatial Agent: Active</span>
                <span style="background: #047857;">S-101 ENC: Connected</span>
                <span style="background: #0ea5e9;">OSM 지도: Connected</span>
            </div>
        </div>
        
        <div class="main-content">
            <div class="sidebar">
                <div class="chat-box">
                    <textarea id="query" placeholder="질문을 입력하세요... (예: 해양보호구역 3km 이내 선박 충돌 위험구역 분석해줘)">해양보호구역 3km 이내 선박 충돌 위험구역 분석해줘</textarea>
                    <button id="sendBtn" onclick="sendQuery()">GeoLLM 분석 실행</button>
                    <button id="approveBtn" class="approve-btn" onclick="approveTask()">⚠️ 보안 검토 승인 (HITL)</button>
                </div>
                <div id="logArea" class="log-area">
                    <div style="color: #64748b; text-align: center; margin-top: 50px;">대기 중...</div>
                </div>
            </div>
            
            <div class="map-container">
                <div class="map-overlay" id="mapOverlay" style="display: none;">
                    <div class="legend-title">Active Layers</div>
                    <div id="layerInfo" style="font-size: 13px; color: #e2e8f0;"></div>
                </div>
                <div id="map"></div>
            </div>
        </div>
    </div>

    <!-- Leaflet JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <!-- Proj4 and Proj4Leaflet for EPSG:5179 support -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/proj4js/2.9.0/proj4.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/proj4leaflet/1.0.2/proj4leaflet.min.js"></script>
    <script>
        // 초기 위치 설정
        let map = L.map('map').setView([35.1, 129.04], 11);
        
        // OSM 배경 지도 
        const osmLayer = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '© OpenStreetMap contributors'
        });
        
        // EPSG:5179 (Korea TM) CRS 정의
        const crs5179 = new L.Proj.CRS('EPSG:5179',
            '+proj=tmerc +lat_0=38 +lon_0=127.5 +k=0.9996 +x_0=1000000 +y_0=2000000 +ellps=GRS80 +units=m +no_defs',
            {
                resolutions: [125094.232896, 62547.116448, 31273.558224, 15636.779112, 7818.389556, 3909.194778, 1954.597389, 977.2986945, 488.6493472, 244.3246736, 122.1623368, 61.08116841, 30.5405842, 15.2702921, 7.635146051, 3.817573025],
                origin: [-200000.0, 4000000.0]
            }
        );

        // S-101 GreenBlue ENC 로컬 맵 서버 (WMS 연동)
        const s101EncUrl = 'http://localhost:8657/encService';
        const s101Layer = L.tileLayer.wms(s101EncUrl, {
            layers: 's101', 
            format: 'image/png',
            version: '1.3.0',
            transparent: true,
            displayMode: 'BASE,STANDARD,OTHERS',
            colorPalette: 'DAY',
            simplifiedPoint: 'false',
            crs: crs5179, // TileServer 캐싱 지원을 위해 EPSG:5179로 강제 요청
            attribution: '© S-101 GreenBlue ENC',
            errorTileUrl: 'https://server.arcgisonline.com/ArcGIS/rest/services/Ocean/World_Ocean_Base/MapServer/tile/{z}/{y}/{x}'
        });

        // 기본 레이어로 OSM을 맵에 추가
        osmLayer.addTo(map);

        // 레이어 컨트롤(선택 박스)을 우측 상단에 추가하여 사용자가 지도를 스위칭할 수 있도록 구성
        const baseMaps = {
            "OSM 지도 (빠름)": osmLayer,
            "S-101 전자해도 (Docker 연동)": s101Layer
        };
        L.control.layers(baseMaps).addTo(map);

        let currentLayer = null;
        let currentTaskId = null;
        let pollInterval = null;

        function addLog(html, isEntry=true) {
            const logArea = document.getElementById("logArea");
            if (logArea.innerHTML.includes("대기 중")) logArea.innerHTML = "";
            
            if (isEntry) {
                logArea.innerHTML = `<div class="log-entry">${html}</div>` + logArea.innerHTML;
            } else {
                logArea.firstChild.innerHTML += html;
            }
        }

        async function sendQuery() {
            const query = document.getElementById("query").value;
            const btn = document.getElementById("sendBtn");
            const approveBtn = document.getElementById("approveBtn");
            
            btn.disabled = true;
            approveBtn.style.display = "none";
            document.getElementById("mapOverlay").style.display = "none";
            
            if (currentLayer) map.removeLayer(currentLayer);
            
            addLog(`<div id="statusBadge" class="status-badge status-received">RECEIVED</div>
                   <div style="margin-top: 5px;">요청 전송 완료.</div>`);
            
            try {
                const res = await fetch("/api/v1/tasks", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ query: query, organization_id: "test", user_id: "admin" })
                });
                const data = await res.json();
                currentTaskId = data.task_id;
                addLog(`<div style="color: #94a3b8; font-size: 11px;">Task: ${currentTaskId.split('-')[0]}...</div>`);
                
                pollInterval = setInterval(checkStatus, 1500);
            } catch (err) {
                addLog(`<div style="color: #ef4444;">Error: ${err}</div>`);
                btn.disabled = false;
            }
        }

        async function checkStatus() {
            if (!currentTaskId) return;
            const res = await fetch(`/api/v1/tasks/${currentTaskId}`);
            const data = await res.json();
            
            const badge = document.getElementById("statusBadge");
            if (badge) badge.innerText = data.status;
            
            if (data.status === "WAITING_FOR_REVIEW") {
                if (badge) badge.className = "status-badge status-review";
                document.getElementById("approveBtn").style.display = "block";
                clearInterval(pollInterval);
                addLog(`<div>Validation 실패 또는 권한 필요. 관리자 승인을 대기합니다.</div>`, false);
            } else if (data.status === "COMPLETED") {
                if (badge) badge.className = "status-badge status-completed";
                clearInterval(pollInterval);
                document.getElementById("sendBtn").disabled = false;
                renderResult(data.final_result);
            } else if (data.status === "FAILED") {
                if (badge) badge.className = "status-badge status-review";
                clearInterval(pollInterval);
                document.getElementById("sendBtn").disabled = false;
                addLog(`<div style="color: #ef4444;">오류 발생: ${data.error_message}</div>`, false);
            } else {
                if (badge) badge.className = "status-badge status-executing";
            }
        }

        async function approveTask() {
            const btn = document.getElementById("approveBtn");
            btn.disabled = true;
            btn.innerText = "승인 처리 중...";
            
            await fetch(`/api/v1/tasks/${currentTaskId}/approve`, { method: "POST" });
            
            btn.style.display = "none";
            btn.disabled = false;
            btn.innerText = "⚠️ 보안 검토 승인 (HITL)";
            
            addLog(`<div style="color: #22c55e;">✅ 관리자 승인 완료. 실행 재개됨.</div>`);
            pollInterval = setInterval(checkStatus, 1500);
        }

        async function renderResult(result) {
            if (!result || !result.map_layer) {
                addLog(`<div>지도 레이어 정보가 없습니다.</div>`, false);
                return;
            }
            
            const spec = result.map_layer;
            addLog(`<div style="margin-top: 10px; color: #fde047;">${result.summary}</div>`, false);
            
            document.getElementById("mapOverlay").style.display = "block";
            document.getElementById("layerInfo").innerHTML = `
                <div><b>Layer:</b> ${spec.layer_id || "SpatialResult"}</div>
                <div><b>Type:</b> ${spec.source_type}</div>
            `;
            
            let geojsonData = null;
            
            if (spec.source_type === "vector_embedded") {
                geojsonData = spec.data;
            } else if (spec.source_type === "vector_file") {
                const res = await fetch(spec.file_uri.replace("file:///d:/An_GeoLLM/geollm_results/", "/data/"));
                geojsonData = await res.json();
            }
            
            if (geojsonData) {
                currentLayer = L.geoJSON(geojsonData, {
                    style: spec.style || { color: "#ef4444", weight: 2, fillColor: "#ef4444", fillOpacity: 0.3 },
                    onEachFeature: function(feature, layer) {
                        if (feature.properties) {
                            let popupContent = "<div style='color: #0f172a;'>";
                            for (let p in feature.properties) {
                                popupContent += `<b>${p}:</b> ${feature.properties[p]}<br>`;
                            }
                            popupContent += "</div>";
                            layer.bindPopup(popupContent);
                        }
                    }
                }).addTo(map);
                map.fitBounds(currentLayer.getBounds());
            }
        }
    </script>
</body>
</html>
